    "rule.mode" : {
      "comment" : "Picker for how the app is limited",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Method"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制方式"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制方式"
          }
        }
      }
    },
    "rule.mode.budget.note" : {
      "comment" : "Explains the CPU limit method",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briefly pauses the app so its average usage stays under the cap. May affect audio and network connections."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按上限短暂暂停应用，平均占用不超过设定值；可能影响声音和网络连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依上限短暫暫停 App，讓平均用量不超過設定值；可能會影響聲音和網路連線。"
          }
        }
      }
    },
    "rule.mode.gentle.note" : {
      "comment" : "Explains the lower priority method",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lowers scheduling priority so foreground apps get resources first. There's no cap, so usage may not change when the Mac is idle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低调度优先级，前台应用优先获得资源；不设上限，空闲时占用可能不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低排程優先順序，讓前景 App 先拿到資源；不設上限，電腦閒置時用量可能不會變。"
          }
        }
      }
    },
    "rule.mode.suspend.note" : {
      "comment" : "Explains the pause method",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauses the app completely so it uses no CPU. Background playback, downloads and notifications stop until you switch back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全暂停，不占用 CPU。后台播放、下载和消息通知都会停止，回到前台后恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全暫停，不吃 CPU。背景播放、下載和訊息通知都會停下來，切回前景就恢復。"
          }
        }
      }
    },
    "rule.network.help" : {
      "comment" : "Tooltip on the network section",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System network counters for the app's own processes. Shared proxies, traffic sent by the system and short connections may not be fully attributed; the first sample sets the baseline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用自有进程的系统网络计数。共享代理、系统代发与短连接可能无法完整归属；第一帧需要建立速度基线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 自有處理程序的系統網路計數。共用代理、系統代送和短連線可能無法完整歸屬；第一次取樣需要先建立速度基準。"
          }
        }
      }
    },
