    "help.cpu.1" : {
      "comment" : "Help text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% equals one fully busy core. An app's helper processes share this budget."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% 等于一个核心满载，应用的辅助进程共享这个额度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% 等於一顆核心滿載，App 的輔助處理程序共用這個額度。"
          }
        }
      }
    },
    "help.cpu.2" : {
      "comment" : "Help text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limits work by briefly pausing the app, which may affect audio and network connections."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制通过短暂暂停实现，可能影响声音和网络连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制是靠短暫暫停 App 來達成，可能會影響聲音和網路連線。"
          }
        }
      }
    },
    "help.cpu.3" : {
      "comment" : "Help text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Lower Priority” sets no cap and just lets foreground apps go first. “Pause App” stops the app completely until you switch back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“降低优先级”不设上限，只让前台应用优先；“暂停应用”会完全暂停，回到前台后恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「降低優先順序」不設上限，只讓前景 App 優先；「暫停 App」會完全暫停，切回前景就恢復。"
          }
        }
      }
    },
    "help.cpu.title" : {
      "comment" : "Help section",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU Cap"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
