        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除后台规则、显示设置及本地应用数据，并解除正在执行的限制。退出后可在访达中将轻程移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會刪除背景規則、顯示設定和本機 App 資料，並解除正在執行的限制。結束後可以在 Finder 把輕程丟到垃圾桶。"
