    "settings.erase.message" : {
      "comment" : "Confirmation message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes background rules, display settings and local app data, and lifts any active limits. Afterwards you can move TaskEase to the Trash in Finder."
