    "help.timing.1" : {
      "comment" : "Help text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The timer starts when an app leaves the foreground or is hidden. The limit applies when time is up and lifts the moment you switch back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用离开前台或隐藏后开始计时，到时开始限制，回到前台立即恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 離開前景或被隱藏後開始計時，時間到就開始限制，切回前景馬上恢復。"
          }
        }
      }
    },
    "help.timing.2" : {
      "comment" : "Help text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag all the way left for “Always Limit” — the app is limited even while you use it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖到最左侧为“始终限制”，前台使用时也会限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉到最左邊是「一律限制」，就算在前景使用也會限制。"
          }
        }
      }
    },
