    "help.overview.1" : {
      "comment" : "Help text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hover over CPU, GPU, Memory or Temp for details. Click to pin the card; click again or press Esc to unpin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针移到 CPU、GPU、内存或温度上查看详情；点击可固定卡片，再次点击或按 Esc 取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游標移到 CPU、GPU、記憶體或溫度上就能看詳細資訊；點一下可以固定卡片，再點一次或按 Esc 取消。"
          }
        }
      }
    },
    "help.overview.2" : {
      "comment" : "Help text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colors go from green to red as usage rises. You can change the style in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色从绿到红表示占用由低到高。样式可在设置中切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏色從綠到紅代表用量由低到高，樣式可以在設定裡切換。"
          }
        }
      }
    },
