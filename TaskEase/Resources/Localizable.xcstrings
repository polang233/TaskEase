    "about.star" : {
      "comment" : "Link to the GitHub repository",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjoying TaskEase? It's open source on GitHub — a Star 🌟 would mean a lot!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "软件好用吗？软件开源在 GitHub，欢迎给这个项目点个 Star 🌟"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用得順手嗎？輕程在 GitHub 開源，歡迎幫我們點個 Star 🌟"
          }
        }
      }
    },
    "about.tagline" : {
      "comment" : "One-line description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what your apps use, and rein in their CPU when they move to the background."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看应用占用，按前后台状态限制 CPU 资源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看看各個 App 用了多少資源，切到背景時幫你壓住 CPU。"
          }
        }
      }
    },
